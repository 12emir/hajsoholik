---
import { getCollection } from 'astro:content'
import Footer from '../../components/Footer.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import { site } from '../../data/site'
import BaseLayout from '../../layouts/BaseLayout.astro'

// Szkice (draft: true) nie trafiają na stronę.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.publishedAt.localeCompare(a.data.publishedAt),
)

const pageTitle = 'Blog — promocje bankowe rozliczone na zł/h | Hajsoholik'
const metaDescription =
  'Poradniki Hajsoholik: BIK i zdolność kredytowa, podatek od premii, realne terminy wypłat i metodologia ROI. Dane weryfikowane u źródeł.'

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog Hajsoholik',
    url: `${site.url}/blog`,
    description: metaDescription,
    publisher: { '@type': 'Organization', name: site.publisher },
  }),
]

const fmtDate = (iso: string) =>
  new Date(`${iso}T12:00:00+02:00`).toLocaleDateString('pl-PL', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
---

<BaseLayout title={pageTitle} description={metaDescription} path="/blog" jsonLd={jsonLd} bodyClass="bg-[#F8F9FC]">
  <SiteHeader currentPath="/blog" />
  <main id="main-content" class="max-w-[760px] mx-auto px-4 md:px-6 py-10">
    <h1 class="text-2xl md:text-3xl font-black tracking-tight text-zinc-900">Blog</h1>
    <p class="text-sm text-zinc-600 mt-2">
      Poradniki o promocjach bankowych: ile realnie zarabiasz (ROI w zł/h), co z BIK-iem
      i zdolnością kredytową, jak rozliczyć premię i kiedy faktycznie przychodzi wypłata.
      Oferty weryfikujemy u źródeł — ostatnio {fmtDate(posts[0]?.data.verifiedAt ?? site.updatedAt)}.
    </p>

    <div class="mt-8 flex flex-col gap-4">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="block bg-white border border-zinc-100 rounded-[16px] p-5 md:p-6 shadow-xs hover:shadow-md hover:border-zinc-200 transition"
          >
            <div class="flex flex-wrap items-center gap-2 text-[11px] text-zinc-500">
              <time datetime={post.data.publishedAt}>{fmtDate(post.data.publishedAt)}</time>
              {post.data.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-600 font-medium">{tag}</span>
              ))}
            </div>
            <h2 class="text-lg md:text-xl font-bold tracking-tight text-zinc-900 mt-2">{post.data.title}</h2>
            <p class="text-sm text-zinc-600 mt-1.5">{post.data.description}</p>
            <span class="inline-block mt-3 text-[13px] font-bold text-[#007B46]">Czytaj dalej →</span>
          </a>
        ))
      }
    </div>
  </main>
  <Footer currentPath="/blog" />
</BaseLayout>
