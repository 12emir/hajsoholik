---
import { getCollection, render } from 'astro:content'
import Footer from '../../components/Footer.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import { site } from '../../data/site'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const data = post.data

// Limit 62 znaków: pełny tytuł z marką, potem sam tytuł, ostatecznie ucięty na granicy słowa.
const fullTitle = `${data.title} | Hajsoholik`
const clamp = (text: string, max: number) => {
  if (text.length <= max) return text
  const cut = text.slice(0, max - 1)
  return `${cut.slice(0, cut.lastIndexOf(' ')).trimEnd()}…`
}
const pageTitle = fullTitle.length <= 62 ? fullTitle : clamp(data.title, 62)

const fmtDate = (iso: string) =>
  new Date(`${iso}T12:00:00+02:00`).toLocaleDateString('pl-PL', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.publishedAt,
    dateModified: data.updatedAt,
    author: { '@type': 'Organization', name: site.publisher, url: `${site.url}/o-redakcji` },
    publisher: { '@type': 'Organization', name: site.publisher },
    mainEntityOfPage: `${site.url}/blog/${post.id}`,
    keywords: data.tags.join(', '),
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Hajsoholik', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/blog/${post.id}` },
    ],
  }),
]
---

<BaseLayout
  title={pageTitle}
  description={data.description}
  path={`/blog/${post.id}`}
  jsonLd={jsonLd}
  bodyClass="bg-[#F8F9FC]"
  showFreshness
>
  <SiteHeader currentPath="/blog" />
  <main id="main-content" class="max-w-[760px] mx-auto px-4 md:px-6 py-10">
    <nav aria-label="Ścieżka nawigacji" class="text-[13px] text-zinc-500 mb-6">
      <a href="/" class="hover:text-zinc-800">Hajsoholik</a>
      <span aria-hidden="true"> / </span>
      <a href="/blog" class="hover:text-zinc-800">Blog</a>
    </nav>

    <h1 class="text-2xl md:text-3xl font-black tracking-tight text-zinc-900">{data.title}</h1>
    <div class="flex flex-wrap items-center gap-2 text-[11px] text-zinc-500 mt-3">
      <span>Opublikowano: <time datetime={data.publishedAt}>{fmtDate(data.publishedAt)}</time></span>
      <span aria-hidden="true">·</span>
      <span>Oferty zweryfikowano u źródeł: <time datetime={data.verifiedAt}>{fmtDate(data.verifiedAt)}</time></span>
      {data.tags.map((tag) => (
        <span class="px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-600 font-medium">{tag}</span>
      ))}
    </div>

    {
      data.notice && (
        <p class="mt-4 bg-amber-50 border border-amber-200 text-amber-900 text-[13px] rounded-xl px-4 py-3">
          {data.notice}
        </p>
      )
    }

    <article class="prose-hj mt-6">
      <Content />
    </article>

    <aside class="mt-8 bg-zinc-900 text-white rounded-[16px] p-5 text-[13px] leading-relaxed">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-2">Zastrzeżenie</h2>
      <p>
        Treści na blogu mają charakter informacyjny i nie stanowią porady inwestycyjnej,
        podatkowej ani prawnej. Premie, terminy i warunki pochodzą z regulaminów
        zweryfikowanych {fmtDate(data.verifiedAt)} — przed działaniem sprawdź aktualny
        regulamin u źródła. Szczegóły metody: <a href="/o-redakcji" class="underline font-bold">o-redakcji</a>.
      </p>
    </aside>
  </main>
  <Footer currentPath="/blog" />
</BaseLayout>

<style>
  /* Hand-rolled prose (bez @tailwindcss/typography) — spójne z designem listingów. */
  @reference "../../styles/globals.css";
  .prose-hj :global(h2) {
    @apply text-xl font-black tracking-tight text-zinc-900 mt-8 mb-3;
  }
  .prose-hj :global(h3) {
    @apply text-base font-bold tracking-tight text-zinc-900 mt-6 mb-2;
  }
  .prose-hj :global(p) {
    @apply text-[15px] leading-relaxed text-zinc-700 my-3;
  }
  .prose-hj :global(ul),
  .prose-hj :global(ol) {
    @apply text-[15px] leading-relaxed text-zinc-700 my-3 pl-5;
  }
  .prose-hj :global(ul) {
    @apply list-disc;
  }
  .prose-hj :global(ol) {
    @apply list-decimal;
  }
  .prose-hj :global(li) {
    @apply my-1.5;
  }
  .prose-hj :global(a) {
    @apply text-[#007B46] font-semibold underline underline-offset-2 hover:text-[#005c34];
  }
  .prose-hj :global(table) {
    @apply w-full text-[13px] my-4 border-collapse bg-white rounded-xl overflow-hidden shadow-xs;
  }
  .prose-hj :global(th) {
    @apply text-left font-bold text-zinc-700 px-3 py-2 bg-zinc-100 border-b border-zinc-200;
  }
  .prose-hj :global(td) {
    @apply px-3 py-2 text-zinc-700 border-b border-zinc-100 align-top;
  }
  .prose-hj :global(blockquote) {
    @apply border-l-4 border-[#007B46]/40 bg-white pl-4 pr-3 py-2 my-4 text-[14px] text-zinc-600 italic rounded-r-xl;
  }
  .prose-hj :global(strong) {
    @apply font-bold text-zinc-900;
  }
  .prose-hj :global(hr) {
    @apply my-6 border-zinc-100;
  }
</style>
