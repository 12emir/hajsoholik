---
import ComperiaOfferCard from '../components/comperia/ComperiaOfferCard.astro'
import { getComperiaCategory, getComperiaSyncedAt } from '../data/comperia'
import BaseLayout from '../layouts/BaseLayout.astro'

const category = getComperiaCategory('kg')
const syncedDate = getComperiaSyncedAt()?.slice(0, 10)
const title = 'Ranking kredytów gotówkowych 2026 — rata i koszt | Hajsoholik'
const description =
  'Porównaj aktualne oferty kredytów gotówkowych w polskich bankach. Sprawdź miesięczną ratę, prowizję i całkowity koszt kredytu, złóż wniosek online.'
---

<BaseLayout
  title={title}
  description={description}
  path="/kredyty-gotowkowe"
>
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-zinc-500">
      <a href="/" class="hover:text-zinc-900">Strona główna</a>
      <span>/</span>
      <span class="text-zinc-900 font-medium">Kredyty gotówkowe</span>
    </nav>

    <!-- Header sekcji -->
    <header class="mb-8 border-b border-zinc-200 pb-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800 mb-3">
        Dane z {syncedDate ?? '2026'} • {category.count} aktywnych ofert bankowych
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl">
        Ranking Kredytów Gotówkowych 2026
      </h1>
      <p class="mt-3 max-w-3xl text-base text-zinc-600">
        Niezależne zestawienie kredytów gotówkowych i pożyczek konsolidacyjnych. Porównaj całkowity koszt kredytu, prowizję banku oraz wysokość raty (kalkulacja bazowa: <strong>10 000 zł na 36 miesięcy</strong>).
      </p>
    </header>

    <!-- Siatka ofert -->
    <section class="space-y-4">
      {
        // COM-005: badge wyłącznie z danych — najniższy koszt całkowity, bez „wyboru użytkowników”.
        category.offers.map((offer) => {
          const koszt = Number(offer.koszt_calkowity)
          const najnizszy =
            Number.isFinite(koszt) &&
            koszt === Math.min(...category.offers.map((o) => Number(o.koszt_calkowity) || Infinity))
          return (
            <ComperiaOfferCard
              offer={offer}
              categoryCode="kg"
              badge={najnizszy ? 'Najniższy koszt całkowity' : undefined}
            />
          )
        })
      }
    </section>

    <!-- Informacja prawna / E-E-A-T -->
    <footer class="mt-12 rounded-2xl bg-zinc-50 p-6 text-xs text-zinc-500 border border-zinc-200">
      <p class="font-semibold text-zinc-700 mb-1">Informacja o pośrednictwie finansowym:</p>
      <p>
        Serwis Hajsoholik.pl jest serwisem informacyjno-porównywarkowym i nie pobiera żadnych opłat od klientów. Prezentowane kalkulacje mają charakter szacunkowy i informacyjny dla kwoty 10 000 zł na okres 36 miesięcy, a ostateczna decyzja oraz warunki umowy kredytowej zależą od indywidualnej oceny zdolności kredytowej przeprowadzonej przez bank.
      </p>
      <p class="mt-2">
        Wartość RRSO oznaczona jako „obliczona” jest wyliczona przez Hajsoholik na podstawie danych Comperia (kwota 10 000 zł, suma rat i całkowity koszt kredytu); jest orientacyjna i może różnić się od RRSO podawanej przez bank w reprezentatywnym przykładzie.
      </p>
    </footer>
  </main>
</BaseLayout>
