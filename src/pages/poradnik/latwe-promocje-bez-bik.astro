---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { PROMOTIONS, slugify } from '../../data/promotions'

const path = '/poradnik/latwe-promocje-bez-bik'
const title = 'Łatwe promocje bankowe bez BIK — lista 2026 | Hajsoholik'
const description =
  'Promocje bankowe, w których nie sprawdzamy BIK ani nie wpływamy na zdolność kredytową: konta, aplikacje i polecenia. Aktualna lista zweryfikowanych ofert.'

// Lista budowana z danych: tylko opublikowane oferty (PROMOTIONS po refillu afiliacyjnym),
// bez weryfikacji BIK i bez wpływu na zdolność kredytową.
const oferty = PROMOTIONS.filter((p) => p.bezBIK && p.bezWplywu).sort((a, b) => b.roi - a.roi)
---

<BaseLayout title={title} description={description} path={path}>
  <div class="max-w-3xl mx-auto px-4 md:px-6 py-10">
    <nav aria-label="Ścieżka nawigacji" class="text-[13px] text-zinc-500 mb-6">
      <a href="/" class="hover:text-zinc-800">Hajsoholik</a>
      <span aria-hidden="true"> / </span>
      <span class="text-zinc-800 font-medium">Poradnik</span>
    </nav>

    <p class="text-[12px] font-bold tracking-widest text-hj-muted uppercase mb-2">Poradnik</p>
    <h1 class="font-black text-[28px] leading-tight mb-3">Łatwe promocje bankowe bez BIK</h1>
    <p class="text-hj-muted-strong text-[15px] leading-relaxed mb-6">
      Nie każda promocja bankowa dotyka Twojej historii kredytowej. Poniżej aktualne oferty, w których
      <strong>nie ma weryfikacji BIK</strong> i <strong>założenie konta nie wpływa na zdolność kredytową</strong>
      — czyli najbezpieczniejszy sposób na pierwsze premie. Listę budujemy automatycznie z tych samych danych,
      co strony ofert, a warunki weryfikowaliśmy {oferty[0]?.verifiedAt ?? 'ostatnio'}.
    </p>

    <section class="space-y-3">
      {
        oferty.map((promo) => (
          <a
            href={`/promocja/${slugify(promo.title)}`}
            class="block rounded-2xl border border-zinc-200 bg-white p-4 hover:border-zinc-400 transition-colors"
          >
            <div class="flex items-center justify-between gap-3">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">{promo.bank}</span>
                <h2 class="text-[15px] font-bold text-zinc-900 leading-snug">{promo.title}</h2>
              </div>
              <span class="shrink-0 rounded-full bg-emerald-50 border border-emerald-100 px-3 py-1 text-[13px] font-extrabold text-emerald-700">
                do {promo.bonus} zł
              </span>
            </div>
            <p class="mt-1 text-[12px] text-zinc-500">
              Effort: {promo.difficulty} • Czas: {promo.timeMinutes} min • ~{promo.roi} zł/h
            </p>
          </a>
        ))
      }
    </section>

    <section class="mt-8 text-hj-muted-strong text-[15px] leading-relaxed">
      <h2 class="font-bold text-hj-text text-[17px] mb-2">Dlaczego „bez BIK" ma znaczenie</h2>
      <p>
        Zapytanie do BIK przy wniosku o konto lub kartę jest odnotowywane w Twojej historii i — przy
        kilku w krótkim czasie — może obniżyć scoring przy prawdziwym kredycie hipotecznym. Oferty
        z tej listy nie wymagają takiego zapytania, więc możesz realizować kilka naraz bez ryzyka.
        Pełniejsze wyjaśnienie: <a class="underline font-semibold" href="/blog/bik-i-zdolnosc-kredytowa-przy-promocjach-bankowych">BIK a zdolność kredytowa przy promocjach</a>.
      </p>
      <h2 class="font-bold text-hj-text text-[17px] mt-6 mb-2">Zasady, których trzymamy się przy selekcji</h2>
      <ul class="list-disc pl-5 space-y-1 text-[14px]">
        <li>Tylko oferty z aktywnym linkiem do regulaminu u źródła.</li>
        <li>Bez opłat za prowadzenie w okresie promocji — koszt zawsze w danych oferty.</li>
        <li>Terminy liczone z daty końca promocji, status odświeżany przy każdym buildzie.</li>
      </ul>
      <p class="mt-4 text-[13px] text-hj-muted">
        Treść ma charakter informacyjny, nie stanowi porady finansowej. Przed wnioskiem sprawdź
        aktualny regulamin u źródła.
      </p>
    </section>
  </div>
</BaseLayout>
