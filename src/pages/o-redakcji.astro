---
import { site } from '../data/site'
import BaseLayout from '../layouts/BaseLayout.astro'

const pageTitle = 'O redakcji i metodzie weryfikacji ofert | Hajsoholik'
const metaDescription = `Jak Hajsoholik weryfikuje promocje bankowe: źródła, wzór ROI, terminy i linki afiliacyjne. Wydawca: ${site.publisher}.`

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: pageTitle,
    url: `${site.url}/o-redakcji`,
    inLanguage: 'pl-PL',
    publisher: {
      '@type': 'Organization',
      name: 'Hajsoholik',
      legalName: site.publisher,
      url: site.url,
    },
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Hajsoholik', item: site.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'O redakcji i metodzie weryfikacji',
        item: `${site.url}/o-redakcji`,
      },
    ],
  }),
]

const kroki = [
  {
    t: 'Skąd bierzemy dane',
    d: 'Podstawą każdej oferty jest regulamin promocji opublikowany przez bank (PDF lub strona promocji) oraz komunikaty banku. Kwotę premii wpisujemy jako maksymalną wartość deklarowaną w regulaminie — nie jako kwotę gwarantowaną. Warunki, haczyki i wymagane kroki przepisujemy z regulaminu, a nie z materiałów reklamowych.',
  },
  {
    t: 'Data weryfikacji przy każdej ofercie',
    d: 'Każda oferta ma pole „Weryfikacja" z datą ostatniego sprawdzenia regulaminu u źródła. Regulaminy banków zmieniają się w trakcie trwania promocji — data mówi wprost, na kiedy dane były prawdziwe, zamiast sugerować stałą aktualność.',
  },
  {
    t: 'Termin i status oferty',
    d: 'Termin podajemy jako konkretną datę z regulaminu. Status („Aktywna", „Kończy się w 48h", „Archiwalna") wyliczamy z tej daty i dnia, w którym wyświetlasz stronę — także w przeglądarce. Dzięki temu oferta po terminie nie jest pokazywana jako aktywna, a jej strona zostaje w serwisie jako archiwum z oznaczeniem „Zakończona".',
  },
  {
    t: 'ROI w złotych za godzinę',
    d: 'ROI liczymy wzorem: ROI = (premia − koszty) ÷ czas pracy w godzinach. Czas pracy to nasz szacunek na podstawie liczby wymaganych kroków (wniosek, wpływ, transakcje kartą, logowania). Koszty to opłaty za prowadzenie konta lub karty wymagane do otrzymania premii. Wartość ROI jest szacunkiem redakcji, a nie obietnicą wyniku — dla programów rozłożonych w czasie bywa niższa niż sama premia.',
  },
  {
    t: 'Czego nie robimy',
    d: 'Nie gwarantujemy przyznania premii, nie obiecujemy zysku i nie używamy sformułowań typu „pewny zysk". Nie publikujemy nieaktualnego terminu jako aktywnego. Nie oznaczamy ofert jako „bez BIK", jeśli regulamin przewiduje weryfikację w Biurze Informacji Kredytowej.',
  },
  {
    t: 'Linki afiliacyjne i niezależność',
    d: 'Serwis utrzymuje się z prowizji od linków afiliacyjnych do banków i giełd. Linki tego typu oznaczamy w kodzie jako sponsored i pokazujemy je wyłącznie jako przyciski prowadzące do oferty. Linki do regulaminów i oficjalnych stron promocji banków nie są afiliacyjne. Prowizja nie wpływa na ocenę redakcyjną, kolejność ofert w wynikach ani na wysokość prezentowanej premii.',
  },
  {
    t: 'Zgłaszanie błędów',
    d: 'Znalazłeś nieaktualną kwotę, brakujący haczyk w regulaminie albo ofertę, której termin już minął? Napisz na adres kontaktowy podany w stopce — poprawki wdrażamy w kolejnej aktualizacji bazy i aktualizujemy datę weryfikacji oferty.',
  },
]
---

<BaseLayout title={pageTitle} description={metaDescription} path="/o-redakcji" jsonLd={jsonLd}>
  <div class="max-w-[900px] mx-auto px-4 md:px-6 py-8 md:py-12">
    <nav aria-label="Ścieżka nawigacji" class="text-[13px] text-zinc-500 mb-6">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:underline hover:text-zinc-900">Hajsoholik</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-zinc-900 font-semibold" aria-current="page">O redakcji</li>
      </ol>
    </nav>

    <header class="bg-white rounded-[16px] border border-zinc-100 p-6 md:p-8">
      <h1 class="text-[26px] md:text-[32px] font-black leading-tight">
        O redakcji i metodzie weryfikacji ofert
      </h1>
      <p class="text-[14px] text-zinc-600 leading-relaxed mt-4">
        Hajsoholik to porównywarka promocji bankowych i produktów finansowych w Polsce. Wydawcą serwisu
        jest {site.publisher}. Nie jesteśmy bankiem, doradcą finansowym ani pośrednikiem bankowym —
        zbieramy publiczne regulaminy promocji i porządkujemy je tak, żeby dało się je porównać:
        premia, koszt wejścia, czas realizacji, wymagane kroki i termin.
      </p>
      <p class="text-[13px] text-zinc-600 leading-relaxed mt-3">
        Ostatnia weryfikacja ofert u źródeł: <strong>{site.updatedAt}</strong>. Serwis prowadzimy od
        2024 roku, a baza obejmuje konta osobiste i firmowe, karty kredytowe, konta oszczędnościowe,
        lokaty, programy poleceń, cashback oraz promocje giełd kryptowalut.
      </p>
    </header>

    <section aria-labelledby="metoda-heading" class="mt-6 bg-white rounded-[16px] border border-zinc-100 p-6">
      <h2 id="metoda-heading" class="text-[18px] font-black">Jak weryfikujemy oferty</h2>
      <div class="mt-4 space-y-4">
        {kroki.map((item, index) => (
          <article class="border-b border-zinc-100 last:border-0 pb-4 last:pb-0">
            <h3 class="text-[15px] font-bold">
              <span class="text-zinc-400 mr-1.5" aria-hidden="true">{index + 1}.</span>{item.t}
            </h3>
            <p class="text-[13px] text-zinc-600 leading-relaxed mt-1.5">{item.d}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="kontakt-heading" class="mt-6 bg-white rounded-[16px] border border-zinc-100 p-6">
      <h2 id="kontakt-heading" class="text-[18px] font-black">Kontakt i dokumenty</h2>
      <ul class="mt-3 space-y-2 text-[13px] text-zinc-600">
        <li>Kontakt w sprawach ofert i poprawek: <a href="/kontakt" class="underline hover:text-zinc-900">strona kontaktowa</a>.</li>
        <li>Zasady korzystania z serwisu: <a href="/regulamin" class="underline hover:text-zinc-900">regulamin</a>.</li>
        <li>Dane, pliki cookies i pomiar ruchu: <a href="/polityka-prywatnosci" class="underline hover:text-zinc-900">polityka prywatności</a>.</li>
      </ul>
      <p class="text-[12px] text-zinc-500 leading-relaxed mt-4">
        Serwis nie świadczy usług doradztwa inwestycyjnego ani finansowego w rozumieniu ustawy o obrocie
        instrumentami finansowymi. Decyzję o skorzystaniu z oferty podejmujesz samodzielnie, po zapoznaniu
        się z aktualnym regulaminem banku.
      </p>
    </section>
  </div>
</BaseLayout>
