---
import ComperiaOfferCard from '../components/comperia/ComperiaOfferCard.astro'
import { getComperiaCategory, getComperiaSyncedAt } from '../data/comperia'
import BaseLayout from '../layouts/BaseLayout.astro'

const category = getComperiaCategory('lb')
const syncedDate = getComperiaSyncedAt()?.slice(0, 10)
const title = 'Ranking lokat bankowych 2026 — oprocentowanie | Hajsoholik'
const description =
  'Aktualne zestawienie najlepszych lokat bankowych w Polsce. Porównaj oprocentowanie w skali roku, zysk na czysto i warunki otwarcia lokaty online.'
---

<BaseLayout
  title={title}
  description={description}
  path="/lokaty-bankowe"
>
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-zinc-500">
      <a href="/" class="hover:text-zinc-900">Strona główna</a>
      <span>/</span>
      <span class="text-zinc-900 font-medium">Lokaty bankowe</span>
    </nav>

    <!-- Header sekcji -->
    <header class="mb-8 border-b border-zinc-200 pb-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800 mb-3">
        Gwarancja BFG do 100 000 EUR • dane z {syncedDate ?? '2026'} • {category.count} lokat
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl">
        Ranking Lokat Bankowych 2026
      </h1>
      <p class="mt-3 max-w-3xl text-base text-zinc-600">
        Bezpieczne pomnażanie kapitału. Zestawienie lokat krótko- i długoterminowych. Prezentujemy oprocentowanie w skali roku oraz realny zysk netto po potrąceniu podatku Belki (19%).
      </p>
    </header>

    <!-- Siatka ofert -->
    <section class="space-y-4">
      {
        // COM-007: badge wyłącznie z danych — maks. oprocentowanie oraz „bez konta” z plusów oferty.
        category.offers.map((offer) => {
          const oproc = Number(offer.oprocentowanie)
          const najwyzsze =
            Number.isFinite(oproc) &&
            oproc === Math.max(...category.offers.map((o) => Number(o.oprocentowanie) || -Infinity))
          const plusy = String(offer.plusy ?? '')
          const bezKonta = plusy.toLowerCase().includes('bez konta')
          const badge = najwyzsze
            ? 'Najwyższe oprocentowanie'
            : bezKonta
              ? 'Bez konta osobistego'
              : undefined
          return <ComperiaOfferCard offer={offer} categoryCode="lb" badge={badge} />
        })
      }
    </section>

    <!-- Informacja prawna / E-E-A-T -->
    <footer class="mt-12 rounded-2xl bg-zinc-50 p-6 text-xs text-zinc-500 border border-zinc-200">
      <p class="font-semibold text-zinc-700 mb-1">Bezpieczeństwo środków (BFG):</p>
      <p>
        Wszystkie prezentowane lokaty bankowe podlegają pod system gwarantowania Bankowego Funduszu Gwarancyjnego (lub odpowiednika w danym kraju UE, np. w Niemczech czy Francji) do równowartości 100 000 EUR na jednego klienta w jednym banku.
      </p>
    </footer>
  </main>
</BaseLayout>
