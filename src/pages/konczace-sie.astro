---
import { PROMOTIONS, type Promotion, deadlineHuman, promoPath, statusOf } from '../data/promotions'
import { site } from '../data/site'
import BaseLayout from '../layouts/BaseLayout.astro'

// Ten sam „teraz" co w reszcie builda — status wyliczamy z daty, nie z importu danych.
const now = new Date(`${site.buildDate}T12:00:00+02:00`)

const ending = [...PROMOTIONS]
  .filter((p: Promotion) => statusOf(p.deadlineDate, now) !== 'Archiwalna')
  .sort((a, b) => a.deadlineDate.localeCompare(b.deadlineDate))
  .slice(0, 10)

const rows = ending.map((promo) => {
  const status = statusOf(promo.deadlineDate, now)
  return {
    promo,
    status,
    statusClass:
      status === 'Kończy się w 48h'
        ? 'bg-red-50 text-red-700'
        : status === 'Archiwalna'
          ? 'bg-zinc-200 text-zinc-700'
          : 'bg-[#007B46]/10 text-[#007B46]',
  }
})

const [soonest] = ending
const soonestLabel = soonest
  ? `${deadlineHuman(soonest.deadlineDate)}: ${ending
      .slice(0, 3)
      .map((p) => `${p.bank} (${p.bonus} zł)`)
      .join(', ')}`
  : 'brak ofert z aktywnym terminem'

const faq = [
  {
    q: 'Która promocja bankowa kończy się najszybciej?',
    a: `Aktualnie najpilniejsze oferty to te z terminem ${soonestLabel}. Daty końca pochodzą wprost z regulaminów banków — lista poniżej jest sortowana od najkrótszej daty. Po upływie terminu oferta trafia do archiwum (status „Archiwalna") i nie jest pokazywana jako aktywna.`,
  },
  {
    q: 'Czy warto czekać na nowe promocje, czy skorzystać z kończących się?',
    a: 'Promocje bankowe cyklicznie wracają (np. mBank i BNP odnawiają oferty co sezon), ale wysokość premii i warunki potrafią się zmieniać. Jeśli widzisz ofertę z wysoką premią i terminem w tym miesiącu, realizacja zajmuje zwykle 15–60 minut — warto działać przed końcem. Dołącz do naszej porównywarki, żeby nie przegapić odświeżeń.',
  },
  {
    q: 'Jak Hajsoholik ustala terminy promocji?',
    a: `Terminy pochodzą wprost z regulaminów i komunikatów banków i podajemy je jako konkretne daty (bez liczników, które starzeją się w cache). Status oferty wyliczamy z tej daty i dnia, w którym widzisz stronę — ostatnia aktualizacja bazy: ${site.updatedAt}. Dzięki temu oferta po terminie nie jest pokazywana jako aktywna.`,
  },
]

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Hajsoholik', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Promocje bankowe', item: `${site.url}/` },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Promocje kończące się',
        item: `${site.url}/konczace-sie`,
      },
    ],
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Promocje bankowe kończące się w 2026',
    description:
      'Aktualne promocje bankowe z najkrótszym terminem — posortowane od najpilniejszych.',
    numberOfItems: ending.length,
    itemListElement: ending.map((promo, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${promo.bonus} zł za promocję ${promo.bank} — ${promo.title}`,
      url: `${site.url}${promoPath(promo)}`,
    })),
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  }),
]
---

<BaseLayout
  title={`Kończące się promocje bankowe (${new Date(`${site.buildDate}T12:00:00+02:00`).toLocaleDateString('pl-PL', { month: 'long', year: 'numeric' })}) | Hajsoholik`}
  description={`${ending.length} promocji bankowych z najkrótszym terminem: ${ending
    .slice(0, 3)
    .map((p) => `${p.bank} ${p.bonus} zł`)
    .join(', ')}. Daty z regulaminów banków, status wyliczany na bieżąco.`}
  path="/konczace-sie"
  jsonLd={jsonLd}
  showFreshness
>
  <div class="max-w-[900px] mx-auto px-4 md:px-6 py-8 md:py-12">
    <nav aria-label="Ścieżka nawigacji" class="text-[13px] text-zinc-500 mb-6">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:underline hover:text-zinc-900">Hajsoholik</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/" class="hover:underline hover:text-zinc-900">Promocje bankowe</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-zinc-900 font-semibold" aria-current="page">Kończące się</li>
      </ol>
    </nav>

    <header class="bg-white rounded-[16px] border border-zinc-100 p-6 md:p-8 shadow-[0_8px_30px_rgba(0,0,0,0.04)]">
      <h1 class="text-[26px] md:text-[32px] font-black leading-tight">Promocje bankowe kończące się najszybciej</h1>
      <p class="text-[14px] text-zinc-600 leading-relaxed mt-4">
        Aktualne oferty z najkrótszym terminem ważności, posortowane od najbardziej pilnych. Daty końca
        pochodzą wprost z regulaminów banków; status wyliczamy z daty i dnia wyświetlenia — aktualizacja bazy: {site.updatedAt}.
      </p>
    </header>

    <section aria-labelledby="oferty-heading" class="mt-6 bg-white rounded-[16px] border border-zinc-100 p-6">
      <h2 id="oferty-heading" class="text-[18px] font-black">Najpilniejsze promocje ({ending.length})</h2>
      <div class="overflow-x-auto mt-4">
        <table class="w-full text-left text-[13px]">
          <thead>
            <tr class="text-zinc-500 text-[11px] uppercase tracking-widest border-b border-zinc-200">
              <th scope="col" class="py-2 pr-3 font-bold">Promocja</th>
              <th scope="col" class="py-2 pr-3 font-bold">Bank</th>
              <th scope="col" class="py-2 pr-3 font-bold text-right">Premia</th>
              <th scope="col" class="py-2 pr-3 font-bold text-right">ROI</th>
              <th scope="col" class="py-2 pr-3 font-bold">Termin</th>
              <th scope="col" class="py-2 font-bold">Status</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ promo, status, statusClass }) => (
              <tr class="border-b border-zinc-100 last:border-0">
                <td class="py-3 pr-3">
                  <a href={promoPath(promo)} class="font-semibold hover:text-[#007B46] hover:underline">
                    {promo.title}
                  </a>
                </td>
                <td class="py-3 pr-3 whitespace-nowrap">{promo.bank}</td>
                <td class="py-3 pr-3 text-right font-black whitespace-nowrap">
                  {promo.bonus.toLocaleString('pl-PL')} zł
                </td>
                <td class="py-3 pr-3 text-right text-[#007B46] font-semibold whitespace-nowrap">
                  {promo.roi} zł/h
                </td>
                <td class="py-3 pr-3 whitespace-nowrap">{deadlineHuman(promo.deadlineDate)}</td>
                <td class="py-3">
                  <span class:list={['text-[11px] px-2 py-0.5 rounded-full font-bold', statusClass]}>
                    {status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="faq-heading" class="mt-6 bg-white rounded-[16px] border border-zinc-100 p-6">
      <h2 id="faq-heading" class="text-[18px] font-black">Najczęstsze pytania</h2>
      <div class="mt-4 space-y-3">
        {faq.map((item) => (
          <details class="border border-zinc-100 rounded-[12px] p-4">
            <summary class="font-bold text-[14px] cursor-pointer">{item.q}</summary>
            <p class="text-[14px] text-zinc-600 leading-relaxed mt-2">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
