---
import { ArrowUpRight, Flame, ShieldCheck, Sparkles, Tag, Zap } from 'lucide-react'
---

<section
  aria-labelledby="turbopromki-banner-heading"
  class="relative overflow-hidden my-12 mx-4 md:mx-6 max-w-[1440px] xl:mx-auto rounded-3xl border border-zinc-900 bg-gradient-to-br from-zinc-950 via-zinc-900 to-black text-white p-7 md:p-10 lg:p-12 shadow-[0_24px_60px_-15px_rgba(0,0,0,0.5)]"
>
  {/* Subtelne tło dekoracyjne — siatka i glowing blur */}
  <div
    class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 bg-gradient-to-br from-amber-500/20 via-orange-600/15 to-transparent rounded-full blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 w-80 h-80 bg-gradient-to-tr from-emerald-500/15 via-teal-600/10 to-transparent rounded-full blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-semibold text-amber-300 mb-4">
        <Sparkles className="w-3.5 h-3.5 text-amber-400" aria-hidden="true" />
        <span>Nasz siostrzany serwis z rabatami</span>
      </div>

      <h2
        id="turbopromki-banner-heading"
        class="text-2xl md:text-3xl lg:text-4xl font-black tracking-tight text-white leading-tight"
      >
        Szukasz okazji na zakupy? Poznaj <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-amber-200">TurboPromki.pl</span>
      </h2>

      <p class="mt-3 text-sm md:text-base text-zinc-300 leading-relaxed max-w-xl">
        Codzienny agregator zweryfikowanych kuponów, błędów cenowych i rabatów do <strong>Allegro, AliExpress, x-kom, Media Expert, Ceneo</strong> i setek innych sklepów. Bez rejestracji, w 100% za darmo.
      </p>

      {/* Trust micro-badges */}
      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-zinc-400">
        <div class="flex items-center gap-1.5">
          <Zap className="w-4 h-4 text-amber-400" aria-hidden="true" />
          <span>Aktualizacje na żywo</span>
        </div>
        <div class="flex items-center gap-1.5">
          <Tag className="w-4 h-4 text-orange-400" aria-hidden="true" />
          <span>Kody rabatowe & kupony</span>
        </div>
        <div class="flex items-center gap-1.5">
          <ShieldCheck className="w-4 h-4 text-emerald-400" aria-hidden="true" />
          <span>Tylko sprawdzone okazje</span>
        </div>
      </div>
    </div>

    {/* CTA card / button box */}
    <div class="flex flex-col sm:flex-row lg:flex-col items-start sm:items-center lg:items-end gap-3 shrink-0">
      <a
        href="https://turbopromki.pl/"
        target="_blank"
        rel="noopener"
        class="group/btn inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-white text-zinc-950 font-bold text-sm md:text-base hover:bg-amber-300 hover:text-black active:scale-[0.98] transition-all duration-200 shadow-[0_10px_25px_rgba(255,255,255,0.12)]"
      >
        <Flame className="w-5 h-5 text-orange-600 group-hover/btn:scale-110 transition-transform" aria-hidden="true" />
        <span>Przejdź do TurboPromki.pl</span>
        <ArrowUpRight className="w-4 h-4 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform" aria-hidden="true" />
      </a>
      <span class="text-[11px] text-zinc-400">Otwiera serwis w nowej karcie</span>
    </div>
  </div>
</section>
