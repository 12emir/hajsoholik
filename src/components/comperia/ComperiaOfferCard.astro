---
interface Props {
  offer: {
    id_oferty: string
    bank: string
    oferta: string
    link: string
    logotyp: string
    rata?: string
    prowizja?: string
    oprocentowanie?: string
    koszt_calkowity?: string
    max_kwota_kredytu?: string
    max_okres_kredytu?: string
    odsetki_po_podatku?: string
    kwota_min?: string
    kwota_max?: string
    okres_max?: string
    bik?: string
    zaswiadczenie_o_zarobkach?: string
    marza?: string
    min_wklad_wlasny?: string
    sposob_zalozenia?: string
    plusy?: string[] | string
    minusy?: string[] | string
  }
  categoryCode: 'kg' | 'kh' | 'lb' | 'chw'
  badge?: string
}

const { offer, categoryCode, badge } = Astro.props

const plusyList = Array.isArray(offer.plusy)
  ? offer.plusy
  : typeof offer.plusy === 'string' && offer.plusy.trim()
    ? [offer.plusy]
    : []

const minusyList = Array.isArray(offer.minusy)
  ? offer.minusy
  : typeof offer.minusy === 'string' && offer.minusy.trim()
    ? [offer.minusy]
    : []

const logoSrc = offer.logotyp?.startsWith('//') ? `https:${offer.logotyp}` : offer.logotyp
---

<article class={`relative flex flex-col justify-between rounded-2xl border bg-white p-5 shadow-[0_1px_3px_rgba(0,0,0,0.05)] transition-all hover:border-zinc-400 hover:shadow-[0_8px_24px_rgba(0,0,0,0.08)] ${badge ? 'border-emerald-300 ring-1 ring-emerald-300/50' : 'border-zinc-300'}`}>
  {badge && (
    <div class="absolute -top-3 left-6 inline-flex items-center gap-1.5 rounded-full bg-emerald-700 px-3 py-0.5 text-xs font-bold text-white shadow-xs">
      <span>★</span>
      <span>{badge}</span>
    </div>
  )}

  <div>
    <!-- Header: Bank & Oferta -->
    <div class="flex items-start justify-between gap-4 border-b border-zinc-100 pb-4">
      <div class="flex items-center gap-3">
        <div class="flex h-11 w-28 shrink-0 items-center justify-start overflow-hidden">
          {logoSrc ? (
            <img
              src={logoSrc}
              alt={offer.bank}
              width="112"
              height="40"
              loading="lazy"
              class="max-h-10 max-w-full object-contain"
            />
          ) : (
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-zinc-100 font-bold text-zinc-700">
              {offer.bank.slice(0, 2).toUpperCase()}
            </div>
          )}
        </div>
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{offer.bank}</span>
          <h2 class="text-base font-bold text-zinc-900 leading-snug">{offer.oferta}</h2>
        </div>
      </div>
    </div>

    <!-- Parametry oferty -->
    <div class="grid grid-cols-2 gap-3 py-4 sm:grid-cols-4">
      {categoryCode === 'kg' && (
        <>
          <div class="rounded-xl bg-emerald-50/60 p-2.5 border border-emerald-100">
            <span class="block text-xs font-medium text-emerald-800">Rata (10k / 36m)</span>
            <span class="text-lg font-extrabold text-emerald-700">{offer.rata || '—'} zł</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Oprocentowanie</span>
            <span class="text-base font-bold text-zinc-900">{offer.oprocentowanie || '—'}%</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Prowizja</span>
            <span class="text-base font-bold text-zinc-900">{offer.prowizja || '0.00'}%</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Koszt całkowity</span>
            <span class="text-base font-bold text-zinc-900">{offer.koszt_calkowity ? `${offer.koszt_calkowity} zł` : '—'}</span>
          </div>
        </>
      )}

      {categoryCode === 'kh' && (
        <>
          <div class="rounded-xl bg-emerald-50/60 p-2.5 border border-emerald-100">
            <span class="block text-xs font-medium text-emerald-800">Miesięczna rata</span>
            <span class="text-lg font-extrabold text-emerald-700">{offer.rata || '—'} zł</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Oprocentowanie</span>
            <span class="text-base font-bold text-zinc-900">{offer.oprocentowanie || '—'}%</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Marża banku</span>
            <span class="text-base font-bold text-zinc-900">{offer.marza || '—'}%</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Min. wkład</span>
            <span class="text-base font-bold text-zinc-900">{offer.min_wklad_wlasny || '10'}%</span>
          </div>
        </>
      )}

      {categoryCode === 'lb' && (
        <>
          <div class="rounded-xl bg-emerald-50/60 p-2.5 border border-emerald-100">
            <span class="block text-xs font-medium text-emerald-800">Oprocentowanie / rok</span>
            <span class="text-lg font-extrabold text-emerald-700">{offer.oprocentowanie || '—'}%</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Zysk netto (kalkulacja Comperia)</span>
            <span class="text-base font-bold text-zinc-900">{offer.odsetki_po_podatku ? `${offer.odsetki_po_podatku} zł` : 'Wg kalkulatora'}</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5 col-span-2">
            <span class="block text-xs font-medium text-zinc-600">Wniosek i formalności</span>
            <span class="text-sm font-semibold text-zinc-800 capitalize">{offer.sposob_zalozenia || '100% online'}</span>
          </div>
        </>
      )}

      {categoryCode === 'chw' && (
        <>
          <div class="rounded-xl bg-emerald-50/60 p-2.5 border border-emerald-100">
            <span class="block text-xs font-medium text-emerald-800">Dostępna kwota</span>
            <span class="text-lg font-extrabold text-emerald-700">{offer.kwota_min || '100'} - {offer.kwota_max || '5000'} zł</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Czas spłaty</span>
            <span class="text-base font-bold text-zinc-900">{offer.okres_max || '30 dni'}</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Weryfikacja BIK</span>
            <span class="text-base font-bold text-zinc-900 capitalize">{offer.bik || 'Nie'}</span>
          </div>
          <div class="rounded-xl bg-zinc-50 p-2.5">
            <span class="block text-xs font-medium text-zinc-600">Bez zaświadczeń</span>
            <span class="text-base font-bold text-zinc-900">{offer.zaswiadczenie_o_zarobkach === 'nie' ? 'Tak (oświadczenie)' : 'Wymagane'}</span>
          </div>
        </>
      )}
    </div>

    <!-- Plusy / Cechy wyróżniające -->
    {plusyList.length > 0 && (
      <div class="mb-3 space-y-1 text-xs text-zinc-600">
        {plusyList.slice(0, 2).map((plus) => (
          <div class="flex items-center gap-1.5 text-emerald-700">
            <span class="font-bold">✓</span>
            <span>{plus}</span>
          </div>
        ))}
      </div>
    )}

    {minusyList.length > 0 && (
      <div class="mb-3 space-y-1 text-xs text-zinc-500">
        {minusyList.slice(0, 1).map((minus) => (
          <div class="flex items-start gap-1.5 text-zinc-500">
            <span class="text-zinc-400">•</span>
            <span>{minus}</span>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Przycisk Złóż wniosek + Microcopy zaufania -->
  <div class="mt-3 pt-3 border-t border-zinc-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-1.5 text-xs text-zinc-500">
      <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>Bezpośrednio na szyfrowanej stronie {offer.bank}</span>
    </div>
    <a
      href={offer.link}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="inline-flex items-center justify-center rounded-xl bg-zinc-900 px-6 py-2.5 text-sm font-bold text-white transition-all hover:bg-emerald-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:ring-offset-2"
    >
      Sprawdź wniosek
      <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</article>
